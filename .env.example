# Copy to .env.local for native development, .env for Docker Compose.
# Demo is an explicit isolated fixture mode: no real source access or TV writes.
DEMO_MODE=true
TZ=Europe/Berlin
DASHBOARD_LOCALE=de-DE
DASHBOARD_CONFIG=config.example.json
HOST=127.0.0.1
PORT=4321
DATA_DIR=data

# Production: set DEMO_MODE=false and supply ALL of these.
MACHBAR_URL=
# Leave unset to select mcp when MACHBAR_MCP_ENDPOINT is set, otherwise rest.
# Set explicitly to rest or mcp to override that selection (no error fallback).
# MACHBAR_TRANSPORT=
# REST display credential, or dedicated Household MCP agent token.
MACHBAR_TOKEN=
# MCP: full trusted HTTPS endpoint, configured only in ignored local files.
MACHBAR_MCP_ENDPOINT=
# Optional separate MCP token overriding MACHBAR_TOKEN. Currently write-capable;
# the backend allowlists read calls only. Never reuse a dashboard/TV credential.
MACHBAR_MCP_TOKEN=
HA_URL=
HA_TOKEN=
HA_CALENDAR_ENTITIES=
# Token-only display: no PocketID, PUBLIC_URL or certificate needed in the app.
# Keep HTTP on loopback/private networks; use HTTPS/VPN for untrusted transport.
AUTH_MODE=token
# Optional origin in token mode; required for OIDC and brightness telemetry.
PUBLIC_URL=
# Optional browser login: set AUTH_MODE=oidc and supply all OIDC settings.
# OIDC requires trusted HTTPS for PUBLIC_URL and OIDC_ISSUER.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Exact PocketID subject IDs authorized to view/administer this household.
OIDC_ALLOWED_SUBJECTS=
# Three DISTINCT random secrets: openssl rand -hex 32
DISPLAY_TOKEN=
WORKER_TOKEN=
ADMIN_TOKEN=

# Optional read-only brightness observer; disabled in config.example.json.
# Requires non-demo mode; never implements or enables TV-setting writes.
# New independent secret, different from display/worker/admin/upstream secrets.
BRIGHTNESS_TELEMETRY_TOKEN=

MACHBAR_REFRESH_SECONDS=60
CALENDAR_REFRESH_SECONDS=300
LIVE_REFRESH_SECONDS=60
STALE_AFTER_INTERVALS=3
EVENING_TRANSITION=19:00
MAX_VISIBLE_TASKS=5

# Host port bind; set an actual local interface only in your ignored .env.
DASHBOARD_BIND_ADDRESS=127.0.0.1
# npm run deploy builds this local tag and removes only its owned old images.
DASHBOARD_IMAGE=frame-dashboard-core:local
COMPOSE_PROJECT_NAME=frame-dashboard
ART_MODE_ENABLED=false
ART_EVALUATION_SECONDS=60
ART_MIN_UPLOAD_INTERVAL_SECONDS=300
TV_HOST=
TV_PORT=8002
# Must be explicitly enabled after the hardware's non-waking behavior is verified.
TV_SAFE_PROBES_CONFIRMED=false
TV_MATTE=none
# Packaging only. Provision the TV token in an ignored file/URL fragment.
# DASHBOARD_URL=https://your-trusted-local-host/display#token=DISPLAY_TOKEN
DASHBOARD_URL=
# Packaging opt-in only: set to the matching BRIGHTNESS_TELEMETRY_TOKEN.
# Leave UNSET for a normal shell without foreground telemetry. Requires HTTPS.
# TIZEN_BRIGHTNESS_TELEMETRY_TOKEN=
