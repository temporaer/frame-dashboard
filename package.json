{
  "name": "frame-dashboard",
  "version": "0.1.0",
  "description": "A self-hosted, read-only household gallery display for Samsung The Frame.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "start": "node --env-file-if-exists=.env.local scripts/server.mjs",
    "deploy": "node scripts/deploy.mjs",
    "cli": "node --env-file-if-exists=.env.local scripts/dashboard.mjs",
    "brightness:observe": "node --env-file-if-exists=.env.local scripts/brightness.mjs",
    "worker": "node --env-file-if-exists=.env.local scripts/worker.mjs",
    "test": "node --test test/*.test.js",
    "shell:config": "node --env-file-if-exists=.env.local scripts/shell-config.mjs",
    "android:build": "npm run shell:config && cd android && ./gradlew assembleRelease",
    "tizen:build": "node --env-file-if-exists=.env.local scripts/package-tizen.mjs",
    "tizen:probe": "node scripts/package-tizen.mjs --probe",
    "tizen:install": "sh scripts/tizen.sh install",
    "launcher:preview": "node launcher/scripts/serve.mjs",
    "launcher:build": "sh launcher/scripts/tizen.sh build",
    "launcher:install": "sh launcher/scripts/tizen.sh install"
  },
  "license": "MIT",
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "openid-client": "^6.8.1",
    "zod": "^4.1.12"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
